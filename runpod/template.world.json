{
  "name": "image-to-world",
  "image": "docker.io/karabibik/image-to-3d-world:v0.1.0",
  "category": "NVIDIA",
  "disk": 60,
  "mounts": {
    "persistent": { "size": 200, "path": "/workspace" }
  },
  "ports": ["7860/http", "8888/http", "22/tcp"],
  "env": {
    "UI_USERNAME": "admin",
    "UI_PASSWORD": "{{ RUNPOD_SECRET_ui_password }}",
    "HF_TOKEN": "{{ RUNPOD_SECRET_hf_token }}",
    "PREFETCH_MODELS": "hypano hyworld1"
  },
  "allowedCudaVersions": ["12.8", "12.9", "13.0", "13.1", "13.2", "13.3", "13.4"],
  "startJupyter": true,
  "startSsh": true,
  "public": false
}
